<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            Las pruebas se ejecutan contra PostgreSQL, NO contra SQLite en memoria.

            Es más lento y exige tener la base levantada, y aun así es la única opción
            honesta: el esquema de este proyecto usa deliberadamente características de
            PostgreSQL que SQLite no tiene —índices únicos parciales, tablas
            particionadas, extensiones, restricciones CHECK con expresiones—. Probar
            sobre SQLite daría una suite verde que no demuestra nada sobre lo que
            realmente se despliega, que es la peor clase de prueba: la que da confianza
            sin darla.

            En local: `make test`, que levanta la base con compose.
            En integración continua: el servicio postgres:17 del workflow.
        -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_DATABASE" value="casa47_test"/>
        <env name="DB_USERNAME" value="casa47"/>
        <env name="DB_PASSWORD" value="secret"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
